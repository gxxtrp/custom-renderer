{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_PREFIX_PATH": "${sourceDir}/build/deps",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/clang-windows.cmake"
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/clang-linux.cmake"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug configuration with assertions and debug symbols",
            "inherits": ["windows-base", "linux-base"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENGINE_PROFILING_ENABLE": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Optimized release configuration",
            "inherits": ["windows-base", "linux-base"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENGINE_PROFILING_ENABLE": "OFF"
            }
        },
        {
            "name": "profile",
            "displayName": "Profile",
            "description": "Optimized configuration with Tracy profiling instrumentation",
            "inherits": ["windows-base", "linux-base"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENGINE_PROFILING_ENABLE": "ON"
            }
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer",
            "description": "AddressSanitizer configuration with symbols and dynamic runtime",
            "inherits": ["windows-base", "linux-base"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
                "ENGINE_ENABLE_ASAN": "ON",
                "ENGINE_PROFILING_ENABLE": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "profile",
            "configurePreset": "profile"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}
